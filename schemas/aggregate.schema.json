{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "period",
    "metric",
    "count",
    "verification"
  ],
  "properties": {
    "period": {
      "enum": [
        "Q1",
        "Q2"
      ]
    },
    "metric": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "count": {
      "type": "integer",
      "minimum": 0
    },
    "verification": {
      "const": "structural_audit"
    }
  }
}
