{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "indicator_id",
    "indicator_type",
    "indicator_value",
    "source_periods",
    "source_references"
  ],
  "properties": {
    "indicator_id": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "indicator_type": {
      "enum": [
        "ipv4",
        "ipv6",
        "sha256"
      ]
    },
    "indicator_value": {
      "type": "string",
      "minLength": 1
    },
    "source_periods": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Q1",
          "Q2"
        ]
      }
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "line",
          "source_sha256"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
